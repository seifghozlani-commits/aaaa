{% {% extends "template_job.html.twig  " %} %}
{% block title %}
    {{ parent () }}
{% endblock %} 

{% block body %}
    <h3>detail Job</h3>
    <hr>
    {% if job %}
    <table class ="table table-border">
        <tr>
            <td>Type</td><td>{{ job.getType }}</td>
        </tr> 
        
        <tr>
            <td>Description</td><td>{{ job.getDescription }}</td>
        </tr>
        
        <tr>
            <td>Email</td><td>{{ job.getEmail }}</td>
        </tr>   
            
        <tr>
            <td>Company</td><td>{{ job.getCompany }}</td>
        </tr>

        <tr>
            <td>Dte Expiration</td><td>{{ job.getExpiresAt | date("d-m-Y") }}</td>
        </tr>

    </table>
    
    {% if listeC | length > 0 %}
        <h3> liste des condidatures ...</h3>
        {% for c in listeC %}
            <ul>
                <li>nom et prenom : {{ c.candidat }}</li>
                <li>contenu :{{ c.contenu }}</li>
                <li>date depot : {{ c.date | date("d-m-Y") }}</li>
            </ul>
    {% endfor %}

    {% else %}

    {<p class="text-danger">code job incorrect</p>}
    {% end if %}
{% endblock %} 