{% extends "template_job.html.twig" %}
{% block title%}

{{ parent ()}} 
{%endblock%}

{% block body%}

<h3> Detail job</h3>

<hr>

{% if jobs | length > 0 %}
<table class="table "table-bordered-stripped">
<thead>
<tr>
<th>Type </th>
<th>Description <th>
<th>Email <th>
<th>Company <th>
<th>Date Expiration <th>
<th></th>

</thead>


</tr>
{%for job in jobs%}
<tr>
<td> {{job.getType}} </td>
<td> {{job.getDescription}} </td>
<td> {{job.getEmail}} </td>
<td> {{job.getCompany}} </td>
<td> {{job.getExpiresAt | date("d-m-y")}} </td>
<td></td>

</tr>
{% endfor %}

</table>

{%else%}

{<p class="text-danger"> Aucune job  </p>}
{% endif %}
{% endblock %}